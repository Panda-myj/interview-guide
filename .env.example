# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
AI_BAILIAN_API_KEY=your_dashscope_api_key_here

# ================================
# 用户认证
# ================================

# 生产必填：至少 32 字节的随机字符串；可用 openssl rand -base64 48 生成
AUTH_JWT_SECRET=change_me_to_a_random_secret_at_least_32_bytes
# 引导管理员手机号，统一使用 E.164 格式；mock 模式下也是唯一可用管理员
APP_AUTH_BOOTSTRAP_PHONE=+8618913371131

# mock：本地开发；pnvs：个人主体短信认证（推荐）；aliyun：企业主体普通短信
APP_AUTH_SMS_PROVIDER=mock
APP_AUTH_EXPOSE_DEBUG_CODE=true
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_LOGIN_CODE_TEMPLATE=
ALIYUN_SMS_LOGIN_ALERT_TEMPLATE=

# ------------------------------------------------------------
# 号码认证服务（PNVS）短信认证：个人实名主体可用
# 免资质、免自建签名模板；只能发验证码，不能发通知或营销短信
#
# 凭证取值位置：
#   ACCESS_KEY_ID / SECRET : RAM 控制台 https://ram.console.aliyun.com/manage/ak
#                            建议 RAM 子用户，最小权限 dypns:SendSmsVerifyCode
#   SIGN_NAME              : 赠送签名配置 https://dypns.console.aliyun.com/smsCertParamsConfig/sign
#   TEMPLATE_CODE          : 赠送模板配置 https://dypns.console.aliyun.com/smsCertParamsConfig/template
#                            签名必须搭配赠送模板，CODE 形如 100001
#   开通与功能开关          : https://dypns.console.aliyun.com/functions
#   API 在线调试            : https://api.aliyun.com/api/Dypnsapi/2017-05-25/SendSmsVerifyCode
#   用量 / 回执             : https://dypns.console.aliyun.com/statistic/sms_cas2
#                            https://dypns.console.aliyun.com/smsCertParamsConfig/status
#
# 切换真实短信：填齐下面 4 项后，把 APP_AUTH_SMS_PROVIDER 改为 pnvs、
# APP_AUTH_EXPOSE_DEBUG_CODE 改为 false；缺任一项 AuthBootstrapValidator 会拒绝启动。
# 计费：套餐包优先抵扣，超额按量，运营商回执失败不计费，核验免费。
# ------------------------------------------------------------
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
# 可选：方案名不填即「默认方案」；以下默认值与本地 6 位码 / 5 分钟 / 60 秒冷却对齐
# ALIYUN_PNVS_SCHEME_NAME=
# ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
# ALIYUN_PNVS_COUNTRY_CODE=86
# ALIYUN_PNVS_TEMPLATE_EXPIRY_MINUTES=5
# ALIYUN_PNVS_CODE_LENGTH=6
# ALIYUN_PNVS_VALID_TIME_SECONDS=300
# ALIYUN_PNVS_INTERVAL_SECONDS=60

# Provider API Key 加密密钥（必填；生产环境请替换为随机长字符串，部署后保持不变）
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# 可选：运行期 Provider/语音配置的本机落点。
# 留空（推荐）表示只写数据库与进程内存，不生成任何本机文件。
# 显式配置后只会写入 ${ENV} 占位符，使用原子替换与 0600 权限；禁止指向源码目录或 classpath。
# APP_AI_CONFIG_YAML_PATH=/var/lib/interview-guide/runtime-config.yml

# 本地调试 lmstudio 等需要放行本机/内网地址；生产 profile 已强制为 false
# APP_AI_ALLOW_LOCAL_ENDPOINTS=true

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-k2.6

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 可选配置 - 与根目录 docker-compose.yml 对齐（本地 bootRun 连 compose 起的依赖时勿改）
# ================================

# PostgreSQL（compose：库 interview_guide / 用户 postgres；请自行设置随机密码）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_random_password

# Redis（compose 映射 6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# RustFS 容器凭据：docker-compose.dev.yml 的必填项，缺失时 compose 直接报错。
# 本地开发请与下方 APP_STORAGE_ACCESS_KEY / APP_STORAGE_SECRET_KEY 填相同值
RUSTFS_ACCESS_KEY=replace_with_random_access_key
RUSTFS_SECRET_KEY=replace_with_random_secret_key

# MinIO / S3 兼容存储（compose：请设置独立随机凭据；开发网络不映射 9001）
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=replace_with_random_access_key
APP_STORAGE_SECRET_KEY=replace_with_random_secret_key
APP_STORAGE_BUCKET=interview-guide

# AI 模型配置（默认: qwen3.5-flash）
AI_MODEL=qwen3.5-flash

# ================================
# 生产部署（docker-compose.yml 默认 SPRING_PROFILES_ACTIVE=prod）
# ================================

# Flyway 会自动创建业务表；首次创建 pgvector 表时临时开启，随后改回 false
# PGVECTOR_INIT_SCHEMA=true

# 生产 CORS 白名单：改成真实访问域名，多个用英文逗号分隔
# CORS_ALLOWED_ORIGINS=https://your-domain.com

# 生产日志（容器内路径，已挂载 app_logs 卷持久化）
# LOG_FILE=logs/app.log
# LOG_LEVEL_ROOT=INFO

# Actuator 暴露端点；需要 Prometheus 时设为 health,info,metrics,prometheus
# ACTUATOR_ENDPOINTS=health,info

# 语音面试（可选）：多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=1600
# APP_VOICE_ASR_SILENCE_MS=1000
# HTTP TTS 模型（默认 qwen3-tts-flash；账户需关闭“仅使用免费额度”或保留可用额度）
# APP_VOICE_TTS_MODEL=qwen3-tts-flash
