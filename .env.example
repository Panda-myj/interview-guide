# ================================
# 必需配置 - 请替换为您的实际密钥
# ================================

# 阿里云百炼 AI (DashScope) - LLM + ASR + TTS 服务
PROVIDER_DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ================================
# 用户认证
# ================================

# 生产必填：至少 32 字节的随机字符串；可用 openssl rand -base64 48 生成
# ⚠️ 部署前必须替换下面两个 change_me_* 占位符：它们是仓库公开值，
#    直接使用可伪造管理员 JWT、并解密数据库中存储的 Provider API Key。
AUTH_JWT_SECRET=change_me_to_a_random_secret_at_least_32_bytes
# 引导管理员手机号，统一使用 E.164 格式；mock 模式下也是唯一可用管理员
APP_AUTH_BOOTSTRAP_PHONE=+8618913371131

# mock：本地开发；pnvs：个人主体短信认证（推荐）；aliyun：企业主体普通短信
APP_AUTH_SMS_PROVIDER=mock
APP_AUTH_EXPOSE_DEBUG_CODE=true
# 本地调试便利开关：mock 模式下允许免登录访问 /api/llm-provider/**（生产/真实短信下开启会拒绝启动）
APP_AUTH_DEV_ANONYMOUS_ADMIN=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_LOGIN_CODE_TEMPLATE=

# ------------------------------------------------------------
# 号码认证服务（PNVS）短信认证：个人实名主体可用
# 免资质、免自建签名模板；只能发验证码，不能发通知或营销短信
#
# 凭证取值位置：
#   ACCESS_KEY_ID / SECRET : RAM 控制台 https://ram.console.aliyun.com/manage/ak
#                            建议 RAM 子用户，最小权限 dypns:SendSmsVerifyCode
#   SIGN_NAME              : 赠送签名配置 https://dypns.console.aliyun.com/smsCertParamsConfig/sign
#   TEMPLATE_CODE          : 赠送模板配置 https://dypns.console.aliyun.com/smsCertParamsConfig/template
#                            签名必须搭配赠送模板，CODE 形如 100001
#   开通与功能开关          : https://dypns.console.aliyun.com/functions
#   API 在线调试            : https://api.aliyun.com/api/Dypnsapi/2017-05-25/SendSmsVerifyCode
#   用量 / 回执             : https://dypns.console.aliyun.com/statistic/sms_cas2
#                            https://dypns.console.aliyun.com/smsCertParamsConfig/status
#
# 切换真实短信：填齐下面 4 项后，把 APP_AUTH_SMS_PROVIDER 改为 pnvs、
# APP_AUTH_EXPOSE_DEBUG_CODE 改为 false；缺任一项 AuthBootstrapValidator 会拒绝启动。
# 计费：套餐包优先抵扣，超额按量，运营商回执失败不计费，核验免费。
# ------------------------------------------------------------
ALIYUN_PNVS_ACCESS_KEY_ID=
ALIYUN_PNVS_ACCESS_KEY_SECRET=
ALIYUN_PNVS_SIGN_NAME=
ALIYUN_PNVS_TEMPLATE_CODE=
# 可选：方案名不填即「默认方案」；以下默认值与本地 6 位码 / 5 分钟 / 60 秒冷却对齐
# ALIYUN_PNVS_SCHEME_NAME=
# ALIYUN_PNVS_ENDPOINT=dypnsapi.aliyuncs.com
# ALIYUN_PNVS_COUNTRY_CODE=86
# ALIYUN_PNVS_TEMPLATE_EXPIRY_MINUTES=5
# ALIYUN_PNVS_CODE_LENGTH=6
# ALIYUN_PNVS_VALID_TIME_SECONDS=300
# ALIYUN_PNVS_INTERVAL_SECONDS=60

# Provider API Key 加密密钥（必填；部署前必须替换为随机长字符串，部署后保持不变）
# ⚠️ 更换该值会使数据库中已加密的 API Key 无法解密，需通过设置页重新录入所有 Provider Key。
APP_AI_CONFIG_ENCRYPTION_KEY=change_me_provider_api_key_encryption_key

# 可选：运行期 Provider/语音配置的本机落点。
# 留空（推荐）表示只写数据库与进程内存，不生成任何本机文件。
# 显式配置后只会写入 ${ENV} 占位符，使用原子替换与 0600 权限；禁止指向源码目录或 classpath。
# APP_AI_CONFIG_YAML_PATH=/var/lib/interview-guide/runtime-config.yml

# 默认关闭（防 SSRF）。本地调试 lmstudio 等需要放行本机/内网地址时才显式设为 true；
# 生产 profile 另有启动校验，开启会拒绝启动。
# APP_AI_ALLOW_LOCAL_ENDPOINTS=true

# ================================
# 文字服务配置
# ================================

# LM Studio 本地 Provider（可选）
# PROVIDER_LMSTUDIO_API_KEY=lm-studio

# Moonshot AI / Kimi (https://platform.moonshot.cn/)
PROVIDER_KIMI_API_KEY=
PROVIDER_KIMI_MODEL=kimi-latest

# DeepSeek (https://platform.deepseek.com/)
PROVIDER_DEEPSEEK_API_KEY=
PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 AI / GLM (https://open.bigmodel.cn/)
PROVIDER_GLM_API_KEY=
PROVIDER_GLM_MODEL=glm-5

# 自定义 OpenAI 兼容 Provider 示例:
# 添加后需在 application.yml 的 app.ai.providers 中配置对应的 base-url 和 model
# PROVIDER_MYPROVIDER_API_KEY=your_api_key_here

# ================================
# 基础设施连接（默认值面向宿主机 bootRun 直连开发依赖）
# ================================

# 开发依赖需叠加 docker-compose.dev.local.yml 才有宿主机端口映射：
#   docker compose -f docker-compose.dev.yml -f docker-compose.dev.local.yml up -d
# 容器内全栈运行时，compose 会显式注入 postgres / redis / rustfs 服务名，
# 这里的 localhost 只影响宿主机 bootRun。

# PostgreSQL：5432 由 dev.local.yml 映射。密码必须与 postgres_data 卷一致；
# 卷初始化之后改这里不会生效，需 ALTER USER postgres WITH PASSWORD（见 docs/Q&A.md Q14）。
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_random_password

# Redis：dev.local.yml 把容器 6379 映射到宿主机 6380（避开本机已占用的 6379）
REDIS_HOST=localhost
REDIS_PORT=6380

# 对象存储（RustFS，S3 兼容）：开发与生产共用同一套凭据变量。
# Docker Hub 的 minio/minio、minio/mc 仓库已下线，两个 compose 文件都改用 rustfs/rustfs:latest。
# RUSTFS_* 是 RustFS 容器的根凭据；生产 compose 会用它同时设置
# APP_STORAGE_ACCESS_KEY / APP_STORAGE_SECRET_KEY，两处必须一致。
# 本地开发可直接填 rustfsadmin / rustfsadmin（与 application.yml 默认值一致）；
# 生产必须替换为随机长字符串，切勿沿用示例占位符。
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# 本地 bootRun 直连 compose 起的依赖时使用；容器内由 compose 显式改为 http://rustfs:9000。
# 生产 compose 只把 9000 绑定到 127.0.0.1，控制台 9001 不启用。
# 注意：bootRun 注入 .env 时不做变量插值，下面几项必须写实际值，不要写 ${RUSTFS_ACCESS_KEY}。
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=rustfsadmin
APP_STORAGE_SECRET_KEY=rustfsadmin
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=us-east-1

# AI 模型配置（默认: qwen3.5-flash）
PROVIDER_DASHSCOPE_MODEL=qwen3.5-flash

# ================================
# 运行模式
# ================================

# 开发模式（默认 profile）：
#   docker compose -f docker-compose.dev.yml -f docker-compose.dev.local.yml up -d
#   ./gradlew :app:bootRun          # bootRun 会把本文件注入 JVM 环境变量
#   cd frontend && pnpm dev         # Vite 5173，代理 /api、/ws 到 8080
# 生产模式：docker compose up -d --build（默认 SPRING_PROFILES_ACTIVE=prod）

# 生产启动：docker compose up -d --build （默认 SPRING_PROFILES_ACTIVE=prod）
# 生产禁止 mock 短信通道，请把 APP_AUTH_SMS_PROVIDER 改为 pnvs 或 aliyun，
# 并把 APP_AUTH_EXPOSE_DEBUG_CODE / APP_AUTH_DEV_ANONYMOUS_ADMIN 保持 false。
#
# 注意：.env 不会自动注入容器。PNVS / 阿里云短信等变量已在 docker-compose.yml 的
# app.environment 里逐行显式声明；新增自定义变量时必须同步补一行，否则容器内读到的仍是空值。
#
# 业务表由 Flyway 迁移脚本管理；pgvector 的 vector_store 表默认由 Spring AI 幂等补齐
# （compose 默认值 PGVECTOR_INIT_SCHEMA=true）。表建好后可显式设为 false 收紧权限。
# PGVECTOR_INIT_SCHEMA=false

# CORS 允许来源：主 compose 要求此项非空，这里给出开发用的本地来源
# （与 application.yml 默认值一致）。切到生产 profile 时必须改为真实 HTTPS
# 精确域名，不能是 localhost 或 IP 字面量，否则启动校验会拒绝。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:80,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:80

# 生产日志（容器内路径，已挂载 app_logs 卷持久化）
# LOG_FILE=logs/app.log
# LOG_LEVEL_ROOT=INFO

# Actuator 暴露端点：生产校验只允许 health，设置其它端点会导致启动失败。
# ACTUATOR_ENDPOINTS=health

# 语音面试（可选）：以下示例值与 application.yml 默认值一致，按需覆盖。
# 多段 STT 合并后再触发面试官；ASR 句间静音阈值（越大越不易句中切开）
# APP_VOICE_USER_UTTERANCE_DEBOUNCE_MS=2500
# APP_VOICE_ASR_SILENCE_MS=2000
# HTTP TTS 模型（默认 qwen3-tts-flash；账户需关闭“仅使用免费额度”或保留可用额度）
# APP_VOICE_TTS_MODEL=qwen3-tts-flash
